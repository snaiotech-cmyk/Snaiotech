{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/about.php", "destination": "/about", "permanent": true },
    { "source": "/contact.php", "destination": "/contact", "permanent": true },
    { "source": "/services.php", "destination": "/", "permanent": true },
    { "source": "/privacy.php", "destination": "/", "permanent": true },
    { "source": "/terms.php", "destination": "/", "permanent": true },
    { "source": "/services/website-development.php", "destination": "/webdev", "permanent": true },
    { "source": "/services/web-mobile-apps.php", "destination": "/webdev", "permanent": true },
    { "source": "/services/seo-marketing.php", "destination": "/webdev", "permanent": true },
    { "source": "/services/zoho-suite.php", "destination": "/zoho", "permanent": true },
    { "source": "/services/branding-design.php", "destination": "/", "permanent": true },
    { "source": "/services/hardware-it.php", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
